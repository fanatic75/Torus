<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.torus" name="Torus" version="0.7.0" provider-name="Prateek Banga">

    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        
    </requires>

    
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>

    
    <extension point="xbmc.service" library="service.py" />

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">TorBox-native media browser with local resume</summary>
        <description lang="en_GB">Browse movies and TV with keyless Cinemeta metadata, find instantly-playable TorBox-cached sources via Comet and Torrentio, play in Kodi's native player, and resume where you left off. No API keys — TorBox is linked with a device code, everything else is stored locally.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/fanatic75/Torus</source>
        
    </extension>
</addon>
<addon id="repository.torus" name="Torus Repository" version="1.0.0" provider-name="Prateek Banga">
    <extension point="xbmc.addon.repository" name="Torus Repository">
        <dir>
            <info compressed="false">https://fanatic75.github.io/Torus/addons.xml</info>
            <checksum>https://fanatic75.github.io/Torus/addons.xml.md5</checksum>
            <datadir zip="true">https://fanatic75.github.io/Torus/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Install and auto-update Torus</summary>
        <description lang="en_GB">Repository for the Torus addon.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
