<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Kodi 21 (Omega) settings, version="1".
  Labels reference numeric string IDs from
  resources/language/resource.language.en_gb/strings.po — literal text labels do
  not render reliably in Kodi's settings UI.

  No key typing required for normal use: TorBox is linked in-addon via device code
  (Home > "Link your TorBox account"), and TMDB uses a bundled key. The fields
  below are dropdowns/toggles plus optional advanced overrides.
-->
<settings version="1">
    <section id="plugin.video.torus">

        <category id="sources" label="30000">
            <group id="1">
                <setting id="provider" type="string" label="30001">
                    <level>0</level>
                    <default>comet</default>
                    <constraints>
                        <options>
                            <option label="30010">comet</option>
                            <option label="30011">torrentio</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>30001</heading>
                    </control>
                </setting>
                <setting id="quality_profile" type="string" label="30002">
                    <level>0</level>
                    <default>cinephile</default>
                    <constraints>
                        <options>
                            <option label="30012">cinephile</option>
                            <option label="30013">balanced</option>
                            <option label="30014">datasaver</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>30002</heading>
                    </control>
                </setting>
            </group>
        </category>

        <category id="advanced" label="30003">
            <group id="1">
                <setting id="image_proxy" type="boolean" label="30004">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="prune_enabled" type="boolean" label="30020">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="prune_days" type="integer" label="30021">
                    <level>0</level>
                    <default>365</default>
                    <constraints>
                        <minimum>1</minimum>
                        <maximum>3650</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="prune_enabled">true</dependency>
                    </dependencies>
                    <control type="edit" format="integer">
                        <heading>30021</heading>
                    </control>
                </setting>
                <setting id="tmdb_api_key" type="string" label="30005">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30005</heading>
                    </control>
                </setting>
                <setting id="torbox_api_key" type="string" label="30006">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30006</heading>
                    </control>
                </setting>
            </group>
        </category>

    </section>
</settings>
