<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Kodi 21 (Omega) settings, version="1".
  No key typing required: TorBox is linked in-addon via device code (Home >
  "Link your TorBox account"), and TMDB uses a bundled key. The fields here are
  dropdowns plus an optional advanced TMDB override for power users.
-->
<settings version="1">
    <section id="plugin.video.torus">

        <category id="sources" label="Sources">
            <group id="1">
                <setting id="provider" type="string" label="Source provider">
                    <level>0</level>
                    <default>comet</default>
                    <constraints>
                        <options>
                            <option label="Comet (public)">comet</option>
                            <option label="Torrentio (public)">torrentio</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>Source provider</heading>
                    </control>
                </setting>
                <setting id="quality_profile" type="string" label="Quality profile">
                    <level>0</level>
                    <default>cinephile</default>
                    <constraints>
                        <options>
                            <option label="Cinephile (4K/DV/REMUX, best quality)">cinephile</option>
                            <option label="Balanced (1 link per quality)">balanced</option>
                            <option label="Data Saver (1080p, smallest)">datasaver</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>Quality profile</heading>
                    </control>
                </setting>
            </group>
        </category>

        <category id="advanced" label="Advanced">
            <group id="1">
                <setting id="tmdb_api_key" type="string" label="TMDB API key (optional override)">
                    <level>0</level>
                    <default/>
                    <control type="edit" format="string">
                        <heading>TMDB API key (optional override)</heading>
                    </control>
                </setting>
                <setting id="torbox_api_key" type="string" label="TorBox API key (optional manual override)">
                    <level>0</level>
                    <default/>
                    <control type="edit" format="string">
                        <heading>TorBox API key (optional manual override)</heading>
                    </control>
                </setting>
            </group>
        </category>

    </section>
</settings>
